{
  "name": "ai-credit-scoring-blockchain-layer",
  "version": "1.0.0",
  "description": "Blockchain integration layer for decentralized AI-based credit scoring.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
